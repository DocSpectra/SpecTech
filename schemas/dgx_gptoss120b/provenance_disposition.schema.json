{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speciteller.local/dgx/provenance-disposition-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "supplement_status", "authorization", "bindings", "positive_evidence", "unresolved_evidence", "implementation_deviations", "later_supplement_policy"],
  "properties": {
    "schema_version": {"const": "round2_dgx_gptoss120b_provenance_disposition_v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "supplement_status": {"enum": ["pending", "unavailable"]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_role", "authorization_date", "explicit_author_waiver", "authorizing_statements", "authorized_scope"],
      "properties": {
        "author_role": {"const": "author"},
        "authorization_date": {"type": "string", "pattern": "^2026-08-12$"},
        "explicit_author_waiver": {"type": "boolean"},
        "authorizing_statements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "authorized_scope": {"type": "string", "minLength": 1}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "return_archive_sha256", "source_packet_sha256", "original_audit_sha256", "model_manifest_sha256", "model_blob_sha256", "runtime_archive_sha256"],
      "properties": {
        "run_id": {"const": "dgx-5411bb15be9f"},
        "return_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "original_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "positive_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unresolved_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_blocker_codes", "human_readable", "claims_forbidden"],
      "properties": {
        "audit_blocker_codes": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "human_readable": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "claims_forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "implementation_deviations": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "later_supplement_policy": {"type": "string", "minLength": 1}
  }
}
