{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectech.invalid/schemas/round2_qwen_edit_generation.schema.json",
  "title": "QE-A generated controlled-edit row",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "corpus_id", "source_sent_id", "edit_type", "attempt_index", "status", "reason_codes", "protocol_sha256", "model_blob_sha256", "response_content_sha256"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_id": {"enum": ["ansible_docs", "github_docs"]},
    "source_sent_id": {"type": "string", "minLength": 1},
    "edit_type": {"enum": ["add_specific", "de_specify", "irrelevant_rewrite"]},
    "attempt_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["accepted", "rejected"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
