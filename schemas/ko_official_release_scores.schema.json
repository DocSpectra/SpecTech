{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectech.invalid/schemas/ko_official_release_scores.schema.json",
  "title": "Official author-repository Ko comparator score row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sent_id", "corpus_id", "model_id", "score_raw", "score_min", "score_max",
    "score_direction", "model_version", "adaptation_context", "upstream_commit",
    "run_id", "training_run_id", "input_manifest_sha256", "comparator_config_sha256"
  ],
  "properties": {
    "sent_id": {"type": "string", "minLength": 1},
    "corpus_id": {"enum": ["wikipedia_en", "github_docs", "ansible_docs", "python_312_html"]},
    "model_id": {"const": "ko_author_official_release_se_ad_mean_std"},
    "score_raw": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "score_min": {"const": 0.0},
    "score_max": {"const": 1.0},
    "score_direction": {"const": "higher_is_more_specific"},
    "model_version": {"const": "official-author-repository-postpublication-36f8e835-cpu-v1"},
    "adaptation_context": {"type": "string", "minLength": 1},
    "upstream_commit": {"const": "36f8e835e9dc6087d5b6763accf302db175947b1"},
    "run_id": {"enum": ["run01", "run02", "run03"]},
    "training_run_id": {"type": "string", "minLength": 1},
    "input_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "comparator_config_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
